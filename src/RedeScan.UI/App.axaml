<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RedeScan.UI"
             x:Class="RedeScan.UI.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Ícone de bandeja (desktop). O monitor em segundo plano avisa aqui. -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://RedeScan.UI/Assets/logo.png"
                      ToolTipText="RedeScan"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Abrir RedeScan" Click="OnTrayOpen" />
                        <NativeMenuItem Header="Monitorar rede em segundo plano"
                                        ToggleType="CheckBox" Click="OnTrayToggleMonitor" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Sair" Click="OnTrayExit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Cor de destaque da marca (teal) -->
            <Color x:Key="RsAccentColor">#13A89E</Color>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ===== Tema Escuro ===== -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RsAccent" Color="#16B6AB" />
                    <SolidColorBrush x:Key="RsAccentHover" Color="#1AC8BC" />
                    <SolidColorBrush x:Key="RsAccentSoft" Color="#2216B6AB" />
                    <SolidColorBrush x:Key="RsCardBg" Color="#1C2128" />
                    <SolidColorBrush x:Key="RsContentBg" Color="#14181D" />
                    <SolidColorBrush x:Key="RsHairline" Color="#2A313A" />
                    <Color x:Key="RsSidebarTop">#1A1F26</Color>
                    <Color x:Key="RsSidebarBottom">#12161B</Color>
                    <SolidColorBrush x:Key="RsButtonBg" Color="#232A33" />
                    <SolidColorBrush x:Key="RsButtonHover" Color="#2C3540" />
                    <SolidColorBrush x:Key="RsInputBg" Color="#181D23" />
                    <SolidColorBrush x:Key="RsDanger" Color="#F0646B" />
                    <SolidColorBrush x:Key="RsDangerSoft" Color="#26F0646B" />
                </ResourceDictionary>

                <!-- ===== Tema Claro ===== -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RsAccent" Color="#0E8C84" />
                    <SolidColorBrush x:Key="RsAccentHover" Color="#0B7A73" />
                    <SolidColorBrush x:Key="RsAccentSoft" Color="#1A13A89E" />
                    <SolidColorBrush x:Key="RsCardBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RsContentBg" Color="#F4F6F8" />
                    <SolidColorBrush x:Key="RsHairline" Color="#E2E6EA" />
                    <Color x:Key="RsSidebarTop">#FFFFFF</Color>
                    <Color x:Key="RsSidebarBottom">#EEF1F4</Color>
                    <SolidColorBrush x:Key="RsButtonBg" Color="#EDF0F3" />
                    <SolidColorBrush x:Key="RsButtonHover" Color="#E2E7EC" />
                    <SolidColorBrush x:Key="RsInputBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RsDanger" Color="#C8323A" />
                    <SolidColorBrush x:Key="RsDangerSoft" Color="#1AC8323A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#16B6AB" />
                <ColorPaletteResources x:Key="Light" Accent="#0E8C84" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml" />
        <StyleInclude Source="avares://RedeScan.UI/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
