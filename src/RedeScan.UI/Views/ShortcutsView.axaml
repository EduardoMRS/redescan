<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RedeScan.UI.Controls"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             xmlns:models="clr-namespace:RedeScan.Core.Models;assembly=RedeScan.Core"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="RedeScan.UI.Views.ShortcutsView"
             x:DataType="vm:ShortcutsViewModel">

    <DockPanel>
        <WrapPanel Classes="toolbar" DockPanel.Dock="Top">
            <controls:IconButton Command="{Binding AddShortcutCommand}" Icon="Plus" Text="Adicionar"/>
            <controls:IconButton Command="{Binding RemoveShortcutCommand}" IsEnabled="{Binding HasSelection}" Classes="danger" Icon="DeleteOutline" Text="Remover"/>
            <controls:IconButton Command="{Binding SaveCommand}" Icon="ContentSave" Text="Salvar"/>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}" Margin="0,8,0,0" />

        <Grid ColumnDefinitions="*,12,280">
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Shortcuts}"
                      SelectedItem="{Binding SelectedShortcut}"
                      GridLinesVisibility="Horizontal">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir no navegador interno"
                                  Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding SelectedShortcut}" />
                        <MenuItem Header="Abrir no navegador do sistema"
                                  Command="{Binding OpenInSystemCommand}"
                                  CommandParameter="{Binding SelectedShortcut}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Alvo" Binding="{Binding Target}" Width="2*" />
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="130" />
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:NetworkShortcut">
                                <Button Content="Abrir"
                                        Command="{Binding $parent[DataGrid].((vm:ShortcutsViewModel)DataContext).OpenCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="2" Spacing="6" IsVisible="{Binding HasSelection}">
                <TextBlock Classes="h2" Text="Editar atalho" />
                <TextBlock Text="Nome" Classes="subtle" />
                <TextBox Text="{Binding SelectedShortcut.Name}" />
                <TextBlock Text="Alvo (URL ou IP)" Classes="subtle" />
                <TextBox Text="{Binding SelectedShortcut.Target}" />
                <TextBlock Text="Categoria" Classes="subtle" />
                <TextBox Text="{Binding SelectedShortcut.Category}" />
                <TextBlock Text="Descrição" Classes="subtle" />
                <TextBox Text="{Binding SelectedShortcut.Description}" AcceptsReturn="True" Height="60" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
