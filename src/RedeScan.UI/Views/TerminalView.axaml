<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RedeScan.UI.Controls"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="RedeScan.UI.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

    <DockPanel>
        <!-- Barra de conexão (quebra linha em telas estreitas) -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" Padding="10,10,10,4">
            <WrapPanel Classes="toolbar inline">
                <TextBox Text="{Binding Host}" Width="150" Watermark="host/IP" />
                <TextBox Text="{Binding Port}" Width="70" Watermark="porta" />
                <TextBox Text="{Binding Username}" Width="120" Watermark="usuário" />
                <TextBox Text="{Binding Password}" Width="130" Watermark="senha" PasswordChar="•"
                         KeyDown="OnPasswordKeyDown" />
                <controls:IconButton Classes="accent"
                        Command="{Binding ConnectCommand}" IsVisible="{Binding IsDisconnected}" Icon="LanConnect" Text="Conectar"/>
                <controls:IconButton 
                        Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" Icon="LanDisconnect" Text="Desconectar"/>
                <controls:IconButton Command="{Binding ClearOutputCommand}" Icon="Broom" Text="Limpar"/>
            </WrapPanel>
        </Border>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <!-- Entrada de comando: ocupa toda a largura -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0" Name="CommandBox"
                     Text="{Binding CommandInput}" Watermark="digite o comando e pressione Enter"
                     FontFamily="monospace"
                     IsEnabled="{Binding IsConnected}" />
            <Button Grid.Column="1" Content="Enviar" Classes="accent" Margin="8,0,0,0"
                    Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" />
            <Button Grid.Column="2" Content="Tab" Margin="6,0,0,0" ToolTip.Tip="Completar (Tab)"
                    Command="{Binding SendKeyCommand}" CommandParameter="tab" IsEnabled="{Binding IsConnected}" />
            <Button Grid.Column="3" Content="Ctrl+C" Margin="6,0,0,0" ToolTip.Tip="Interromper o comando"
                    Command="{Binding SendKeyCommand}" CommandParameter="ctrl-c" IsEnabled="{Binding IsConnected}" />
        </Grid>

        <!-- Saída do terminal -->
        <Border Classes="card" Padding="0" Margin="0" Background="#0D1117">
            <ScrollViewer Name="OutputScroll" HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Output}" Foreground="#D6DEE7"
                                     FontFamily="monospace" FontSize="12"
                                     Padding="10" TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
