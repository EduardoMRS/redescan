<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RedeScan.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="RedeScan.UI.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

    <!-- Uma aba por tipo de terminal; cada aba mantém sua própria sessão -->
    <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TerminalTabViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Header}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource RsAccent}"
                             VerticalAlignment="Center" IsVisible="{Binding IsConnected}" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:TerminalTabViewModel">
                <DockPanel Margin="0,10,0,0">
                    <!-- Barra de conexão (quebra linha em telas estreitas) -->
                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" Padding="10,10,10,4">
                        <WrapPanel Classes="toolbar inline">
                            <TextBox Text="{Binding Host}" Width="150" Watermark="host/IP"
                                     IsVisible="{Binding IsRemote}" />
                            <TextBox Text="{Binding Port}" Width="70" Watermark="porta"
                                     IsVisible="{Binding IsRemote}" />
                            <TextBox Text="{Binding Username}" Width="120" Watermark="usuário"
                                     IsVisible="{Binding IsSsh}" />
                            <TextBox Text="{Binding Password}" Width="130" Watermark="senha" PasswordChar="•"
                                     IsVisible="{Binding IsSsh}" KeyDown="OnPasswordKeyDown" />
                            <controls:IconButton Classes="accent" Icon="LanConnect" Text="{Binding ConnectLabel}"
                                                 Command="{Binding ConnectCommand}" IsVisible="{Binding IsDisconnected}"
                                                 IsEnabled="{Binding !IsConnecting}" />
                            <controls:IconButton Icon="LanDisconnect" Text="{Binding DisconnectLabel}"
                                                 Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
                            <controls:IconButton Icon="Broom" Text="Limpar" Command="{Binding ClearOutputCommand}" />
                        </WrapPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />

                    <!-- Entrada de comando: ocupa toda a largura -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,8,0,0">
                        <TextBox Grid.Column="0" Classes="command"
                                 Text="{Binding CommandInput}" Watermark="digite o comando e pressione Enter"
                                 FontFamily="monospace" IsEnabled="{Binding IsConnected}"
                                 AttachedToVisualTree="OnCommandBoxAttached" />
                        <Button Grid.Column="1" Content="Enviar" Classes="accent" Margin="8,0,0,0"
                                Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" />
                        <Button Grid.Column="2" Content="Tab" Margin="6,0,0,0" ToolTip.Tip="Completar (Tab)"
                                Command="{Binding SendKeyCommand}" CommandParameter="tab" IsEnabled="{Binding IsConnected}" />
                        <Button Grid.Column="3" Content="Ctrl+C" Margin="6,0,0,0" ToolTip.Tip="Interromper o comando"
                                Command="{Binding SendKeyCommand}" CommandParameter="ctrl-c" IsEnabled="{Binding IsConnected}" />
                    </Grid>

                    <!-- Saída -->
                    <Border Classes="card" Padding="0" Margin="0" Background="#0D1117">
                        <ScrollViewer Classes="output" HorizontalScrollBarVisibility="Auto"
                                      AttachedToVisualTree="OnOutputAttached">
                            <SelectableTextBlock Text="{Binding Output}" Foreground="#D6DEE7"
                                                 FontFamily="monospace" FontSize="12"
                                                 Padding="10" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
