<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="RedeScan.UI.Views.BrowserView"
             x:DataType="vm:BrowserViewModel">

    <DockPanel>
        <!-- Barra de endereço -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Address}" Width="360" Watermark="https://…"
                         VerticalAlignment="Center" CornerRadius="8" />
                <Button Content="➜ Ir" Classes="accent" Command="{Binding NavigateCommand}" />
                <ComboBox ItemsSource="{Binding Routers}"
                          SelectedItem="{Binding SelectedRouter}"
                          Width="220" VerticalAlignment="Center"
                          PlaceholderText="🖧 Roteadores da rede…">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="↗ Abrir no sistema" Command="{Binding OpenInSystemBrowserCommand}" />
            </StackPanel>
        </Border>

        <!-- Host do conteúdo web: preenchido no code-behind quando o WebView
             nativo está disponível; caso contrário, mostra o fallback abaixo. -->
        <Panel Name="BrowserHost">
            <Border Classes="card" Name="Fallback" Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="520">
                    <Border Classes="pageIcon" Width="64" Height="64" HorizontalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="h2" HorizontalAlignment="Center"
                               Text="Abrir no navegador do sistema" />
                    <TextBlock Classes="subtle" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Digite uma URL na barra de endereço acima e use o botão abaixo para abri-la no navegador padrão do seu sistema. O navegador embutido está disponível na versão completa para Windows." />
                    <Button Content="Abrir no navegador do sistema"
                            Classes="accent"
                            HorizontalAlignment="Center"
                            Command="{Binding OpenInSystemBrowserCommand}" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
