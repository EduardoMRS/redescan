<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RedeScan.UI.Controls"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="RedeScan.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="248,*">

        <!-- ================= Barra lateral ================= -->
        <Border Grid.Column="0" Classes="sidebar">
            <DockPanel>
                <!-- Marca -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="logo" ClipToBounds="True">
                            <Image Source="avares://RedeScan.UI/Assets/logo.png"
                                   Width="40" Height="40" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="RedeScan" Classes="h1" FontSize="20" />
                            <TextBlock Text="Análise &amp; Teste de Redes" Classes="subtle" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rodapé: Configurações fixo no fim do menu (o tema fica lá dentro) -->
                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource RsHairline}" Padding="8,6,8,12">
                    <Button Classes="nav" Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="{Binding SettingsPage.Key, Converter={x:Static controls:ModuleIcons.KeyToIcon}}"
                                                   Width="20" Height="20" />
                            <TextBlock Text="{Binding SettingsPage.Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Navegação (ListBox dá o destaque do item selecionado) -->
                <ListBox Classes="nav"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedMenuPage}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewModelBase">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Definir como tela inicial"
                                                  Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).SetAsStartupCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon><material:MaterialIcon Kind="Home" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <material:MaterialIcon Kind="{Binding Key, Converter={x:Static controls:ModuleIcons.KeyToIcon}}"
                                                       Width="20" Height="20" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Conteúdo ================= -->
        <Border Grid.Column="1" Classes="content">
            <DockPanel Margin="28,24,28,24">
                <!-- Cabeçalho da página -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Classes="pageIcon">
                            <material:MaterialIcon Kind="{Binding CurrentPage.Key, Converter={x:Static controls:ModuleIcons.KeyToIcon}}"
                                                   Width="24" Height="24" Foreground="{DynamicResource RsAccent}" />
                        </Border>
                        <TextBlock Classes="h1" VerticalAlignment="Center"
                                   Text="{Binding CurrentPage.Title}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding CurrentPage}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
