<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="RedeScan.UI.Views.TftpView"
             x:DataType="vm:TftpViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <TextBlock Classes="subtle" TextWrapping="Wrap"
                           Text="Servidor TFTP para recuperar dispositivos em modo de recuperação (firmware). Deixe o firmware na pasta raiz e inicie o servidor; o dispositivo baixa o arquivo pelo IP deste computador." />

                <Grid ColumnDefinitions="110,*,Auto">
                    <TextBlock Grid.Column="0" Text="Pasta raiz" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding RootDirectory}" IsEnabled="{Binding IsStopped}" />
                    <Button Grid.Column="2" Content="📁 Escolher" Margin="8,0,0,0"
                            Click="OnChooseFolder" IsEnabled="{Binding IsStopped}" />
                </Grid>

                <WrapPanel Classes="toolbar">
                    <TextBlock Text="Porta" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Width="130"
                                   IsEnabled="{Binding IsStopped}" FormatString="0" />
                    <CheckBox Content="Permitir upload (receber arquivos)" IsChecked="{Binding AllowWrite}"
                              IsEnabled="{Binding IsStopped}" VerticalAlignment="Center" />
                </WrapPanel>

                <WrapPanel Classes="toolbar">
                    <Button Content="▶ Iniciar servidor" Classes="accent"
                            Command="{Binding StartCommand}" IsVisible="{Binding IsStopped}" />
                    <Button Content="⏹ Parar" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
                    <Button Content="🧹 Limpar log" Command="{Binding ClearLogCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Border Classes="card" Padding="0">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LogLines}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
