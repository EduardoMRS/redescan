<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             xmlns:models="clr-namespace:RedeScan.Core.Models;assembly=RedeScan.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="520"
             x:Class="RedeScan.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Spacing="4">
            <!-- Banner de atualização disponível -->
            <Border Classes="card" IsVisible="{Binding UpdateAvailable}"
                    Background="#2213A89E" BorderBrush="{DynamicResource RsAccent}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="⬆️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding UpdateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="Baixar" Classes="accent" Margin="0,0,6,0"
                            Command="{Binding DownloadUpdateCommand}" />
                    <Button Grid.Column="3" Content="✕" Command="{Binding DismissUpdateCommand}" />
                </Grid>
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" Classes="subtle" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HostName}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP local" Classes="subtle" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalIp}" Margin="0,8,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gateway" Classes="subtle" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gateway}" Margin="0,8,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub-rede" Classes="subtle" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubnetPrefix}" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <TextBlock Text="Interfaces ativas" Classes="h2" />
            <Border Classes="card">
                <ItemsControl ItemsSource="{Binding ActiveInterfaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Button Content="🔄 Atualizar" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />

            <!-- ===== Atalhos: dispositivos com interface web ===== -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <TextBlock Grid.Column="0" Text="Dispositivos com web na rede" Classes="h2" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="90" VerticalAlignment="Center"
                                 IsVisible="{Binding IsDiscovering}" />
                    <CheckBox Content="Auto" IsChecked="{Binding AutoDiscoveryEnabled}"
                              VerticalAlignment="Center" ToolTip.Tip="Verificar a rede automaticamente" />
                    <Button Content="🔎 Procurar" Command="{Binding DiscoverCommand}"
                            IsEnabled="{Binding !IsDiscovering}" />
                    <Button Content="🌐 Roteadores" Command="{Binding FindRoutersCommand}" />
                </StackPanel>
            </Grid>

            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="subtle" Text="{Binding DiscoveryStatus}" Margin="0,0,0,4" />

                    <ItemsControl ItemsSource="{Binding WebDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WebDevice">
                                <Border Padding="10,8" Margin="0,2" CornerRadius="8"
                                        Background="{DynamicResource RsAccentSoft}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="🔗" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayLabel}" />
                                            <TextBlock Text="{Binding PreferredUrl}" Classes="subtle" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Abrir"
                                                Classes="accent" Margin="0,0,6,0"
                                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenDeviceInternalCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Content="↗"
                                                ToolTip.Tip="Abrir no navegador do sistema"
                                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenDeviceSystemCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="subtle" Margin="2,6,0,0"
                               IsVisible="{Binding HasNoWebDevices}"
                               Text="Nenhum dispositivo web encontrado ainda." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
