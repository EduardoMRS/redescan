<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             xmlns:conv="clr-namespace:RedeScan.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="RedeScan.UI.Views.WifiScannerView"
             x:DataType="vm:WifiScannerViewModel">

    <DockPanel>
        <WrapPanel Classes="toolbar" DockPanel.Dock="Top">
            <Button Content="📶 Escanear" Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />
            <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}" Margin="0,8,0,0" />

        <!-- Gráfico de ocupação de canais -->
        <Border DockPanel.Dock="Top" Classes="card" Height="180" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Ocupação por canal" Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ChannelChart}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelOccupancy">
                                <StackPanel Width="46" VerticalAlignment="Bottom" Margin="4,0">
                                    <TextBlock Text="{Binding NetworkCount}" HorizontalAlignment="Center" FontSize="11" />
                                    <Border Width="26" HorizontalAlignment="Center"
                                            Background="{DynamicResource SystemAccentColor}"
                                            CornerRadius="4,4,0,0"
                                            Height="{Binding NetworkCount, Converter={x:Static conv:CountToHeightConverter.Instance}}" />
                                    <TextBlock Text="{Binding Channel}" HorizontalAlignment="Center" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Band}" HorizontalAlignment="Center" Classes="subtle" FontSize="9" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Networks}" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="*" />
                <DataGridTextColumn Header="Sinal %" Binding="{Binding SignalStrengthPercent}" Width="80" />
                <DataGridTextColumn Header="RSSI dBm" Binding="{Binding SignalRssiDbm}" Width="90" />
                <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="70" />
                <DataGridTextColumn Header="Banda" Binding="{Binding Band}" Width="90" />
                <DataGridTextColumn Header="Segurança" Binding="{Binding Security}" Width="120" />
                <DataGridCheckBoxColumn Header="Conectada" Binding="{Binding IsConnected}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
