<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
        x:Class="RedeScan.UI.Views.CameraEditorWindow"
        x:DataType="vm:CameraEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource RsContentBg}">

    <Border Padding="18">
        <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{Binding WindowTitle}" Margin="0,0,0,4" />

            <TextBlock Text="Nome" Classes="subtle" />
            <TextBox Text="{Binding Name}" Watermark="ex.: Entrada principal" />

            <TextBlock Text="Grupo (host)" Classes="subtle" />
            <TextBox Text="{Binding Group}" Watermark="ex.: Matriz, Filial A" />

            <TextBlock Text="Localização" Classes="subtle" />
            <TextBox Text="{Binding Location}" Watermark="ex.: Recepção" />

            <TextBlock Text="URL do stream (RTSP)" Classes="subtle" />
            <TextBox Text="{Binding Url}" Watermark="rtsp://ip:554/..." />

            <Grid ColumnDefinitions="*,10,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Usuário" Classes="subtle" />
                    <TextBox Text="{Binding Username}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Senha" Classes="subtle" />
                    <TextBox Text="{Binding Password}" PasswordChar="•" />
                </StackPanel>
            </Grid>

            <CheckBox Content="Habilitada" IsChecked="{Binding IsEnabled}" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="0,10,0,0">
                <Button Content="Cancelar" Click="OnCancel" />
                <Button Content="Salvar" Classes="accent" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
