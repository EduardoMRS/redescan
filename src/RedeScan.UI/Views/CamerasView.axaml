<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             xmlns:models="clr-namespace:RedeScan.Core.Models;assembly=RedeScan.Core"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="580"
             x:Class="RedeScan.UI.Views.CamerasView"
             x:DataType="vm:CamerasViewModel">

    <DockPanel>
        <!-- Barra de ações -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="➕ Adicionar" Command="{Binding AddCameraCommand}" />
            <Button Content="✏ Editar" Command="{Binding EditCameraCommand}"
                    CommandParameter="{Binding SelectedCamera}" IsEnabled="{Binding HasSelection}" />
            <Button Content="🗑 Remover" Command="{Binding RemoveCameraCommand}"
                    CommandParameter="{Binding SelectedCamera}" IsEnabled="{Binding HasSelection}" />
            <Button Content="💾 Salvar" Classes="accent" Command="{Binding SaveCommand}" />
            <Border Width="1" Background="{DynamicResource RsHairline}" Margin="4,2" />
            <Button Content="📥 Importar rtspList.json" Click="OnImportClick" />
            <Button Content="📤 Exportar" Click="OnExportClick" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="300,12,*">
            <!-- ESQUERDA: tabela de câmeras com busca + filtro por grupo -->
            <Border Grid.Column="0" Classes="card" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchText}" Watermark="🔍 Buscar por nome ou local…" />
                        <ComboBox ItemsSource="{Binding AvailableGroups}"
                                  SelectedItem="{Binding GroupFilter}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding FilteredCameras}"
                             SelectedItem="{Binding SelectedCamera}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:RtspCameraConfig">
                                <Grid ColumnDefinitions="56,8,*" Margin="0,2">
                                    <!-- Miniatura de prévia -->
                                    <Border Grid.Column="0" Width="56" Height="40"
                                            Background="#30000000" CornerRadius="4"
                                            BorderBrush="{DynamicResource RsHairline}" BorderThickness="1">
                                        <TextBlock Text="📷" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.5" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="subtle" FontSize="10"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Group}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Location}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="▶ Reproduzir (slot livre)"
                                          Command="{Binding PlaySelectedCommand}" />
                                <MenuItem Header="✏ Editar"
                                          Command="{Binding EditCameraCommand}"
                                          CommandParameter="{Binding SelectedCamera}" />
                                <MenuItem Header="↗ Abrir no player externo"
                                          Command="{Binding OpenExternalCommand}"
                                          CommandParameter="{Binding SelectedCamera}" />
                                <Separator />
                                <MenuItem Header="🗑 Remover"
                                          Command="{Binding RemoveCameraCommand}"
                                          CommandParameter="{Binding SelectedCamera}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- DIREITA: grade de vídeo em tempo real (1 a 6 câmeras) -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <TextBlock Text="Layout:" VerticalAlignment="Center" Classes="subtle" />
                    <ComboBox ItemsSource="{Binding LayoutOptions}"
                              SelectedItem="{Binding VideoLayout}" Width="80" />
                    <TextBlock Text="câmera(s)" VerticalAlignment="Center" Classes="subtle" />
                    <Button Content="▶ Reproduzir selecionada" Command="{Binding PlaySelectedCommand}"
                            IsEnabled="{Binding HasSelection}" />
                    <Button Content="⏹ Parar tudo" Command="{Binding StopAllCommand}" />
                </StackPanel>

                <Border Classes="card" Padding="6">
                    <ItemsControl Name="VideoGrid" ItemsSource="{Binding ActiveSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding GridColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CameraSlot">
                                <Border Margin="4" MinHeight="140"
                                        Background="#20000000"
                                        BorderBrush="{DynamicResource RsHairline}"
                                        BorderThickness="1" CornerRadius="8"
                                        Tag="{Binding}">
                                    <Grid RowDefinitions="*,Auto">
                                        <!-- Host do vídeo deste slot (preenchido no code-behind) -->
                                        <Panel Grid.Row="0" Name="SlotHost">
                                            <TextBlock Text="{Binding Label}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.45" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Panel>
                                        <Border Grid.Row="1" Background="#40000000" Padding="8,4"
                                                IsVisible="{Binding HasCamera}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Camera.Name}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Content="⏹" Padding="6,2"
                                                        Command="{Binding $parent[ItemsControl].((vm:CamerasViewModel)DataContext).StopSlotCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
