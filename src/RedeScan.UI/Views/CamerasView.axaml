<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RedeScan.UI.ViewModels"
             xmlns:controls="clr-namespace:RedeScan.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="580"
             x:Class="RedeScan.UI.Views.CamerasView"
             x:DataType="vm:CamerasViewModel">

    <DockPanel>
        <!-- Barra de ações: quebra de linha em telas estreitas (nada fica fora da tela) -->
        <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <controls:IconButton Command="{Binding AddCameraCommand}" Icon="Plus" Text="Adicionar"/>
            <controls:IconButton Command="{Binding EditCameraCommand}"
                    CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding HasSelection}" Icon="PencilOutline" Text="Editar"/>
            <controls:IconButton Command="{Binding RemoveCameraCommand}"
                    CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding HasSelection}" Classes="danger" Icon="DeleteOutline" Text="Remover"/>
            <controls:IconButton Classes="accent" Command="{Binding SaveCommand}" Icon="ContentSave" Text="Salvar"/>
            <controls:IconButton Click="OnImportClick" Icon="Import" Text="Importar rtspList.json"/>
            <controls:IconButton Click="OnExportClick" Icon="Export" Text="Exportar"/>
            <controls:IconButton Command="{Binding RefreshThumbnailsCommand}"
                    IsEnabled="{Binding IsFfmpegAvailable}" Icon="ImageRefresh" Text="Atualizar prévias"/>
        </WrapPanel>

        <!-- ffmpeg ausente: oferece instalar sem sair do app -->
        <Border DockPanel.Dock="Top" Classes="card warn" IsVisible="{Binding IsFfmpegMissing}">
            <DockPanel>
                <controls:IconButton DockPanel.Dock="Right" Classes="accent" VerticalAlignment="Center"
                         Command="{Binding InstallFfmpegCommand}"
                        IsEnabled="{Binding !IsInstallingFfmpeg}" Icon="Download" Text="Instalar ffmpeg"/>
                <StackPanel Spacing="2" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="Decodificador de vídeo (ffmpeg) não encontrado" />
                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                               Text="O RedeScan usa o ffmpeg para exibir as câmeras e gerar as prévias. Clique para baixar a versão oficial (sem precisar de administrador)." />
                    <TextBlock Classes="subtle" Text="{Binding InstallProgress}"
                               IsVisible="{Binding IsInstallingFfmpeg}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="300,6,*">
            <!-- ESQUERDA: câmeras com busca + filtro por grupo + miniatura real -->
            <Border Grid.Column="0" Classes="card" Padding="10" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <TextBox Text="{Binding SearchText}" Watermark="Buscar por nome ou local…" />
                        <ComboBox ItemsSource="{Binding AvailableGroups}"
                                  SelectedItem="{Binding GroupFilter}"
                                  HorizontalAlignment="Stretch" />
                        <controls:IconButton HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding PlayAllVisibleCommand}" Icon="Play" Text="Reproduzir todas da lista"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding FilteredCameras}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             DoubleTapped="OnCameraDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CameraListItem">
                                <Grid ColumnDefinitions="80,10,*" Margin="0,2">
                                    <!-- Miniatura de prévia (frame real do stream) -->
                                    <Border Grid.Column="0" Width="80" Height="46"
                                            Background="#30000000" CornerRadius="6" ClipToBounds="True"
                                            BorderBrush="{DynamicResource RsHairline}" BorderThickness="1"
                                            ToolTip.Tip="{Binding ThumbnailError}">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <TextBlock Text="📷" FontSize="18" Opacity="0.45"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasThumbnail}" />
                                            <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom"
                                                         MinHeight="3" Height="3"
                                                         IsVisible="{Binding IsLoadingThumbnail}" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Camera.Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="subtle" FontSize="11" Text="{Binding Subtitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reproduzir"
                                          Command="{Binding PlaySelectedCommand}">
                                    <MenuItem.Icon><material:MaterialIcon Kind="Play" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Editar"
                                          Command="{Binding EditCameraCommand}"
                                          CommandParameter="{Binding SelectedItem}">
                                    <MenuItem.Icon><material:MaterialIcon Kind="PencilOutline" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Abrir no player externo"
                                          Command="{Binding OpenExternalCommand}"
                                          CommandParameter="{Binding SelectedItem}">
                                    <MenuItem.Icon><material:MaterialIcon Kind="OpenInNew" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Remover"
                                          Command="{Binding RemoveCameraCommand}"
                                          CommandParameter="{Binding SelectedItem}">
                                    <MenuItem.Icon><material:MaterialIcon Kind="DeleteOutline" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

            <!-- DIREITA: grade de vídeo ao vivo (1 a 6 câmeras) -->
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
                    <TextBlock Text="Layout:" VerticalAlignment="Center" Classes="subtle" />
                    <ComboBox ItemsSource="{Binding LayoutOptions}"
                              SelectedItem="{Binding VideoLayout}" Width="80" />
                    <controls:IconButton Command="{Binding PlaySelectedCommand}"
                            IsEnabled="{Binding HasSelection}" Icon="Play" Text="Reproduzir selecionada"/>
                    <controls:IconButton Command="{Binding StopAllCommand}" Icon="Stop" Text="Parar tudo"/>
                </WrapPanel>

                <Border Classes="card" Padding="6" Margin="0">
                    <ItemsControl ItemsSource="{Binding ActiveSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding GridColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CameraSlot">
                                <Border Margin="4" MinHeight="140" Background="#20000000"
                                        BorderBrush="{DynamicResource RsHairline}"
                                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid RowDefinitions="*,Auto">
                                        <Panel Grid.Row="0">
                                            <TextBlock Text="{Binding Label}" IsVisible="{Binding !HasCamera}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.45" TextWrapping="Wrap" TextAlignment="Center" />
                                            <controls:VideoSurface Source="{Binding StreamUrl}"
                                                                   IsVisible="{Binding HasCamera}" />
                                        </Panel>
                                        <Border Grid.Row="1" Background="#40000000" Padding="8,4"
                                                IsVisible="{Binding HasCamera}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Camera.Name, FallbackValue='', TargetNullValue=''}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <controls:IconButton Grid.Column="1"  Padding="6,2"
                                                        ToolTip.Tip="Parar este slot"
                                                        Command="{Binding $parent[ItemsControl].((vm:CamerasViewModel)DataContext).StopSlotCommand}"
                                                        CommandParameter="{Binding}" Icon="Stop"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
