<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border Padding="20" Width="300">
            <StackPanel Spacing="10">
                <TextBlock Classes="h1" Text="Título" />
                <TextBlock Classes="h2" Text="Subtítulo" />
                <TextBlock Classes="subtle" Text="Texto secundário" />
                <Border Classes="card">
                    <TextBlock Text="Conteúdo de um cartão" />
                </Border>
                <Button Content="Botão primário" Classes="accent" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ===================== Tipografia ===================== -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,6" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="TextBlock.subtle">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Barra lateral ===================== -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="{DynamicResource RsSidebarTop}" />
                <GradientStop Offset="1" Color="{DynamicResource RsSidebarBottom}" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsHairline}" />
    </Style>

    <!-- Chip do logo -->
    <Style Selector="Border.logo">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
    </Style>

    <!-- Chip do ícone do cabeçalho da página -->
    <Style Selector="Border.pageIcon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
    </Style>

    <Style Selector="Border.content">
        <Setter Property="Background" Value="{DynamicResource RsContentBg}" />
    </Style>

    <!-- ===================== Navegação (ListBox) ===================== -->
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
    </Style>

    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsAccent}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource RsAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
    </Style>

    <!-- Botão estilo nav (rodapé: alternar tema) -->
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsAccent}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="{DynamicResource RsAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================== Barras de ferramentas responsivas =====================
         WrapPanel.toolbar: botões quebram para a linha de baixo em janelas
         estreitas, em vez de sumirem para fora da tela. -->
    <Style Selector="WrapPanel.toolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="WrapPanel.toolbar.inline">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="WrapPanel.toolbar > :is(Control)">
        <Setter Property="Margin" Value="0,0,8,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="WrapPanel.toolbar.inline > :is(Control)">
        <Setter Property="Margin" Value="0,2,6,2" />
    </Style>

    <!-- Cartão de aviso (ffmpeg ausente, certificado, etc.) -->
    <Style Selector="Border.card.warn">
        <Setter Property="Background" Value="#22B07D00" />
        <Setter Property="BorderBrush" Value="#B07D00" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ===================== Cartões ===================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource RsCardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BoxShadow" Value="0 2 10 0 #14000000" />
    </Style>

    <!-- ===================== Botões ===================== -->
    <!-- Padrão: botão neutro discreto, com borda sutil -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{DynamicResource RsButtonBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsHairline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsButtonHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsAccent}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Ação principal -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource RsAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsAccentHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Ação destrutiva (remover) -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource RsDanger}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RsDangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource RsDanger}" />
    </Style>

    <!-- Botões da navegação não usam o visual "neutro" -->
    <Style Selector="Button.nav">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ===================== Campos ===================== -->
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource RsInputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsHairline}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource RsAccent}" />
    </Style>

    <!-- ===================== DataGrid ===================== -->
    <Style Selector="DataGrid">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource RsHairline}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource RsAccent}" />
    </Style>

</Styles>
