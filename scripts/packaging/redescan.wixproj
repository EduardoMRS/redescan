<Project Sdk="WixToolset.Sdk/4.0.5">

  <!--
    Instalador .msi do RedeScan Full (Windows). Usa o HarvestDirectory do WiX v4
    (substituto do heat) para incluir toda a pasta publicada automaticamente,
    gerando a ComponentGroup "HarvestedFiles" ancorada em INSTALLFOLDER.

    Build (runner Windows):
      dotnet build scripts/packaging/redescan.wixproj -c Release `
        -p:PublishDir=<pasta> -p:ProductVersion=<x.y.z>
  -->
  <PropertyGroup>
    <OutputName>RedeScan-Full-Windows-x64</OutputName>
    <OutputType>Package</OutputType>
    <DefineConstants>PublishDir=$(PublishDir);Version=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <!-- NÃO declarar <Compile Include="redescan.wxs"> aqui: o WiX SDK já inclui
       automaticamente todos os *.wxs da pasta. Declarar de novo duplicaria os
       símbolos (WIX0089/WIX0091). -->

  <!-- Harvest de toda a pasta publicada; os componentes vão para HarvestedFiles,
       com a raiz da árvore de diretórios ancorada em INSTALLFOLDER. -->
  <ItemGroup>
    <HarvestDirectory Include="$(PublishDir)">
      <ComponentGroupName>HarvestedFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
  </ItemGroup>

</Project>
