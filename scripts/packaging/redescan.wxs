<!--
  Definicao WiX v4 do instalador .msi do RedeScan Full (Windows).
  Inclui toda a pasta publicada (parametro PublishDir), instala em
  "Program Files\RedeScan" e cria atalho no Menu Iniciar. Construido pelo job
  full-windows do workflow de release (runner Windows, WiX v4).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RedeScan"
           Manufacturer="RedeScan"
           Version="$(Version)"
           UpgradeCode="7B2E9C4A-3D1F-4A6B-9E2C-6F0A1B2C3D4E"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Uma versao mais recente do RedeScan ja esta instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="RedeScanIcon" SourceFile="$(PublishDir)\RedeScan.exe" />
    <Property Id="ARPPRODUCTICON" Value="RedeScanIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RedeScan" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="RedeScan" />
    </StandardDirectory>

    <Feature Id="Main" Title="RedeScan" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <!-- Atalho no Menu Iniciar. -->
    <Component Id="AppShortcut" Directory="AppShortcutFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="RedeScan"
                Target="[INSTALLFOLDER]RedeScan.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="RedeScanIcon" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\RedeScan" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>

  <!-- Inclui recursivamente toda a pasta publicada em INSTALLFOLDER. -->
  <Fragment>
    <ComponentGroup Id="PublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
